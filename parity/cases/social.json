[
  {"id": "activity_stream_read.max_id", "method": "activity_stream_read", "mode": "identical",
   "args": {"entity_type": "Shot", "entity_id": "${twin.id}", "max_id": "${activity.max_id}"},
   "argv": ["activity", "Shot", "${twin.id}", "--max-id", "${activity.max_id}"]},
  {"id": "activity_stream_read.min_id_limit_entity_fields", "method": "activity_stream_read",
   "mode": "identical",
   "args": {"entity_type": "Shot", "entity_id": "${twin.id}", "min_id": "${activity.min_id}",
            "limit": 1, "entity_fields": {"Shot": ["code"]}},
   "argv": ["activity", "Shot", "${twin.id}", "--min-id", "${activity.min_id}", "--limit", "1",
            "--entity-fields", "{\"Shot\": [\"code\"]}"]},
  {"id": "note_thread_read", "method": "note_thread_read", "mode": "identical",
   "args": {"note_id": "${note.id}"},
   "argv": ["note", "thread", "${note.id}"]},
  {"id": "note_thread_read.entity_fields", "method": "note_thread_read", "mode": "identical",
   "args": {"note_id": "${note.id}", "entity_fields": {"Reply": ["content"]}},
   "argv": ["note", "thread", "${note.id}", "--entity-fields", "{\"Reply\": [\"content\"]}"]},
  {"id": "text_search", "method": "text_search", "mode": "identical",
   "args": {"text": "fpt_parity_past", "entity_types": {"Shot": []},
            "project_ids": ["${project.id}"], "limit": 5},
   "argv": ["search", "fpt_parity_past", "--entity-types", "{\"Shot\": []}",
            "--project-id", "${project.id}", "--limit", "5"]},
  {"id": "text_search.filter", "method": "text_search", "mode": "identical",
   "args": {"text": "fpt_parity_past",
            "entity_types": {"Shot": [["code", "is", "fpt_parity_past"]]},
            "project_ids": ["${project.id}"]},
   "argv": ["search", "fpt_parity_past",
            "--entity-types", "{\"Shot\": [[\"code\", \"is\", \"fpt_parity_past\"]]}",
            "--project-id", "${project.id}"]},
  {"id": "follow", "method": "follow", "mode": "mirrored",
   "args": {"user": {"type": "HumanUser", "id": "${user.id}"},
            "entity": {"type": "Shot", "id": "${twin.id}"}},
   "argv": ["follow", "HumanUser:${user.id}", "Shot:${twin.id}"],
   "masks": ["id"], "readback": {"entity": "${twin}", "fields": []}},
  {"id": "followers", "method": "followers", "mode": "identical",
   "args": {"entity": {"type": "Shot", "id": "${twin.id}"}},
   "argv": ["followers", "Shot:${twin.id}"]},
  {"id": "following", "method": "following", "mode": "identical",
   "args": {"user": {"type": "HumanUser", "id": "${user.id}"},
            "project": {"type": "Project", "id": "${project.id}"}, "entity_type": "Shot"},
   "argv": ["following", "HumanUser:${user.id}", "--project", "Project:${project.id}",
            "--entity-type", "Shot"]},
  {"id": "unfollow", "method": "unfollow", "mode": "mirrored",
   "args": {"user": {"type": "HumanUser", "id": "${user.id}"},
            "entity": {"type": "Shot", "id": "${twin.id}"}},
   "argv": ["unfollow", "HumanUser:${user.id}", "Shot:${twin.id}"],
   "masks": ["id"], "readback": {"entity": "${twin}", "fields": []}}
]
