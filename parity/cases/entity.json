[
  {"id": "find.retired_only", "method": "find", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["project", "is", {"type": "Project", "id": "${project.id}"}]],
            "fields": ["code"], "retired_only": true},
   "argv": ["find", "Shot", "-f", "project is Project:${project.id}", "--fields", "code", "--retired-only"]},
  {"id": "get.retired_only", "method": "find_one", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["id", "is", "${victim.id}"]], "fields": ["code"],
            "retired_only": true},
   "argv": ["get", "Shot", "${victim.id}", "--fields", "code", "--retired-only"]},
  {"id": "revive", "method": "revive", "mode": "mirrored",
   "args": {"entity_type": "Shot", "entity_id": "${victim.id}"},
   "argv": ["revive", "Shot", "${victim.id}"],
   "readback": {"entity": "${victim}", "fields": ["code", "description"]}, "masks": ["id"]},
  {"id": "delete", "method": "delete", "mode": "mirrored",
   "args": {"entity_type": "Shot", "entity_id": "${victim.id}"},
   "argv": ["delete", "Shot", "${victim.id}", "--yes"],
   "readback": {"entity": "${victim}", "fields": ["code"]}, "masks": ["id"]},
  {"id": "find.page", "method": "find", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["project", "is", {"type": "Project", "id": "${project.id}"}]],
            "fields": ["code"], "order": [{"field_name": "id", "direction": "asc"}], "limit": 2, "page": 2},
   "argv": ["find", "Shot", "-f", "project is Project:${project.id}", "--fields", "code", "--order", "id",
            "--limit", "2", "--page", "2"]},
  {"id": "find.include_archived_projects", "method": "find", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["project", "is", {"type": "Project", "id": "${project.id}"}]],
            "fields": ["code"], "include_archived_projects": false},
   "argv": ["find", "Shot", "-f", "project is Project:${project.id}", "--fields", "code",
            "--include-archived-projects", "false"]},
  {"id": "find.additional_filter_presets", "method": "find", "mode": "identical",
   "args": {"entity_type": "Version", "filters": [], "fields": ["code"],
            "order": [{"field_name": "id", "direction": "asc"}], "limit": 3,
            "additional_filter_presets": [{"preset_name": "LATEST", "latest_by": "ENTITIES_CREATED_AT"}]},
   "argv": ["find", "Version", "--fields", "code", "--order", "id", "--limit", "3",
            "--additional-filter-presets", "[{\"preset_name\": \"LATEST\", \"latest_by\": \"ENTITIES_CREATED_AT\"}]"]},
  {"id": "get", "method": "find_one", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["id", "is", "${twin.id}"]]},
   "argv": ["get", "Shot", "${twin.id}"]},
  {"id": "get.fields_order_any", "method": "find_one", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["id", "is", "${twin.id}"]], "fields": ["code"],
            "order": [{"field_name": "code", "direction": "desc"}], "filter_operator": "any"},
   "argv": ["get", "Shot", "${twin.id}", "--fields", "code", "--order", "-code", "--any"]},
  {"id": "get.include_archived_projects", "method": "find_one", "mode": "identical",
   "args": {"entity_type": "Shot", "filters": [["id", "is", "${twin.id}"]], "fields": ["code"],
            "include_archived_projects": false},
   "argv": ["get", "Shot", "${twin.id}", "--fields", "code", "--include-archived-projects", "false"]},
  {"id": "get.additional_filter_presets", "method": "find_one", "mode": "identical",
   "args": {"entity_type": "Version", "filters": [["id", "is", 674]], "fields": ["code"],
            "additional_filter_presets": [{"preset_name": "LATEST", "latest_by": "ENTITIES_CREATED_AT"}]},
   "argv": ["get", "Version", "674", "--fields", "code",
            "--additional-filter-presets", "[{\"preset_name\": \"LATEST\", \"latest_by\": \"ENTITIES_CREATED_AT\"}]"]},
  {"id": "create.return_fields", "method": "create", "mode": "mirrored",
   "args": {"entity_type": "Shot", "data": {"code": "fpt_parity_created", "project": "${project}"},
            "return_fields": ["sg_status_list"]},
   "argv": ["create", "Shot", "--set", "code=fpt_parity_created", "--set", "project:=${project}",
            "--return-fields", "sg_status_list"],
   "readback": {"entity": "result", "fields": ["code", "project", "sg_status_list"]}, "masks": ["id"]},
  {"id": "update.multi_entity_update_modes", "method": "update", "mode": "mirrored",
   "args": {"entity_type": "Shot", "entity_id": "${twin.id}",
            "data": {"sg_fpt_parity_multi_entity": ["${project}"]},
            "multi_entity_update_modes": {"sg_fpt_parity_multi_entity": "add"}},
   "argv": ["update", "Shot", "${twin.id}", "--set", "sg_fpt_parity_multi_entity:=[${project}]",
            "--multi-entity-mode", "sg_fpt_parity_multi_entity=add"],
   "readback": {"entity": "${twin}", "fields": ["sg_fpt_parity_multi_entity"]}, "masks": ["id"]},
  {"id": "get.session_token", "method": "find_one", "mode": "identical", "auth": "session",
   "args": {"entity_type": "Shot", "filters": [["id", "is", "${twin.id}"]], "fields": ["code"]},
   "argv": ["get", "Shot", "${twin.id}", "--fields", "code"]},
  {"id": "get.ca_certs", "method": "find_one", "mode": "identical",
   "env": {"FPTCTL_CA_CERTS": "${ca_certs}"},
   "args": {"entity_type": "Shot", "filters": [["id", "is", "${twin.id}"]], "fields": ["code"]},
   "argv": ["get", "Shot", "${twin.id}", "--fields", "code"]}
]
